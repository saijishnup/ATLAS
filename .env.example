# --- LLM (one OpenAI-compatible client; swap by editing the lines below) ---
# OmniRoute gateway (default). Start OmniRoute, open its dashboard (http://localhost:20128), create an API key
# there, and PASTE IT AS LLM_API_KEY below. Never commit the real .env.
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
# Comma list = tried in order; the next model is used when one errors, times out or returns nothing.
# Copy the exact ids from GET http://localhost:20128/v1/models (they may carry a provider prefix).
LLM_MODEL=gemini-3.1-flash-lite,nemotron-3-ultra-550b:free,nemotron-3.5-super-vl-120b,gemini-3.1-pro-preview,gpt-oss-120b@low,mistral-small-2603
LLM_MODE=hosted            # hosted | local
LLM_JSON_MODE=off          # on = send response_format json_object; off for gateways (some upstreams reject it). Output is still schema-validated.
LLM_TIMEOUT=60             # seconds per model call (local mode default 300)
LLM_PROVIDER_LABEL=omniroute   # name shown in the UI badge
# Direct alternatives (set LLM_JSON_MODE=on, clear LLM_PROVIDER_LABEL):
#   Gemini: base https://generativelanguage.googleapis.com/v1beta/openai/   model: a current Flash id
#   Groq:   base https://api.groq.com/openai/v1   model: qwen/qwen3.8-27b (fallbacks qwen/qwen3.6-27b, openai/gpt-oss-120b)
#   Local llama.cpp: base http://localhost:8080/v1   key empty   model any name   LLM_MODE=local

# --- Storage (defaults under var/) ---
# DB_PATH=var/atlas.db
# CHROMA_DIR=var/chroma

# --- Hosted-use guards ---
CORS_ORIGINS=http://localhost:5173   # comma list; add the Vercel URL when the frontend is hosted separately
RATE_LIMIT_PER_MIN=30      # per client IP, 0 = off
TRUST_PROXY_HOPS=0         # 0 = use socket IP. Behind N trusted proxies set N (Render: start with 1, check the limiter really keys per visitor)
DAILY_LLM_CAP=0            # 0 = off
CONCURRENCY=threads        # threads | asyncio
WORKERS=4                  # 1 = serial, use if threads misbehave
